    "version": "1.0.0",
    "decidedAt": "2026-08-31",
    "decision": "earned = pale tile + tier-colored glyph (N glyph is near-black) / locked = candidate A",
    "note": "UR earned tile is a gradient and cannot be stored as a Figma Variable. Use the fallback solid for the variable and define a separate Fill Style. See $gradients."
  },
  "collection": "badge",
  "modes": [
    "default"
  ],
