  "$surfaces": {
    "page-bg": "#FDF9EF",
    "card-bg": "#FFFFFF",
    "card-border": "#F0EBE0",
    "shadow": "#1A1A2E"
  },
  "$geometry": {
    "tile": {
      "size": 96,
      "radius": 20,
      "borderWidth": 1
    },
    "tileUR": {
      "borderWidth": 1.5
    },
    "glyph": {
      "size": 72
    },
    "lockIcon": {
      "size": 40,
      "strokeWidth": 2
    },
    "chip": {
      "diameter": 28,
      "offsetX": 8,
      "offsetY": -8,
      "fontSize": 11,
      "fontWeight": 700
    },
    "label": {
      "marginTop": 8,
      "fontSize": 13,
      "fontWeight": 700,
      "align": "center"
    },
    "shadowEarned": {
      "offsetX": 4,
      "offsetY": 4,
      "blur": 0
    },
    "shadowLocked": null,
    "card": {
      "radius": 16,
      "padding": 20,
      "columns": 4
    }
  },
  "$variableNaming": "badge/{tier}/{earned|locked}/{token}",
  "$glyphSpec": {
    "viewBox": "0 0 24 24",
    "fit": "longest side to 24 (no inner margin)",
    "color": "fill=currentColor",
    "stroke": "none",
    "transparency": "mask (true holes)",
    "minFeatureWidth": 3
  }
}